# Midas Environment Variables
# Copy to .env and fill in real values

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=midas
POSTGRES_USER=midas_user
POSTGRES_PASSWORD=midas_dev_password
DATABASE_URL=postgresql://midas_user:midas_dev_password@localhost:5432/midas

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# === AI token budget ===
# Daily token budget guard (SEC-09). Redis key: ai_budget:YYYY-MM-DD (auto-rotates).
AI_BUDGET_MAX_DAILY_TOKENS=500000

# === xAI Grok (Phase 2.1 voice + text parsing) ===
# Get your key at: https://console.x.ai/
# ONE key powers BOTH: speech-to-text of voice messages AND text/icon parsing.
# STT cost: $0.10/hour of audio (~$0.0002 per 8-second voice message).
XAI_API_KEY=your_xai_api_key_here
# Model for text transaction parsing + category emoji picking (non-reasoning).
# Env-overridable so a future model retirement is a config change, not a redeploy.
XAI_TEXT_MODEL=grok-4.20-0309-non-reasoning

# === Application ===
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
